{
  "functions": {
    "source": ".",
    "codebase": "default",
    "runtime": "nodejs20",
    "ignore": ["node_modules", ".git", "firebase-debug.log"],
    "predeploy": ["npm run build"]
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
