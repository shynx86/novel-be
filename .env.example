# Server (PORT and FIREBASE_* are reserved by Cloud Functions - use these names instead)
SERVER_PORT=3000
NODE_ENV=development

# Project
PROJECT_ID=your-project-id

# Firebase Web API key (from Firebase Console → Project Settings → General → Web Apps)
# Not a secret — this is the same key embedded in your frontend Firebase config
# Note: Can't use FIREBASE_ prefix — reserved by Cloud Functions
WEB_API_KEY=your-firebase-web-api-key

# Path to Firebase service account key JSON (download from Firebase Console → Project Settings → Service Accounts)
# NEVER commit the actual key file to git
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firestore database ID (only needed if not using the default "(default)" database)
# Leave empty to use the default database
FIRESTORE_DATABASE_ID=

# Dashboard admin credentials (hardcoded basic auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-in-production
